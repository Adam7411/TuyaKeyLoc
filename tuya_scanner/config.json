{
  "name": "TuyaKeyLoc",
  "version": "1.5.4",
  "slug": "tuya_scanner",
  "description": "TuyaKeyLoc discovers Tuya devices on LAN, fetches Local Keys via IoT Cloud or Smart Life QR login, and syncs IPs with tuya-local.",
  "url": "https://github.com/Adam7411/TuyaKeyLoc",
  "arch": [
    "aarch64",
    "amd64",
    "armhf",
    "armv7",
    "i386"
  ],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "ports": {
    "7080/tcp": 7080
  },
  "ports_description": {
    "7080/tcp": "Panel webowy"
  },
  "host_network": true,
  "options": {
    "scan_interval": 3600,
    "scan_duration": 18,
    "auto_scan": false,
    "qr_scheme": "smartlife"
  },
  "schema": {
    "scan_interval": "int(60,86400)",
    "scan_duration": "int(5,120)",
    "auto_scan": "bool",
    "qr_scheme": "list(smartlife|tuyaSmart)"
  },
  "panel_icon": "mdi:access-point-network",
  "panel_title": "TuyaKeyLoc",
  "ingress": true,
  "ingress_port": 7080,
  "homeassistant_api": true,
  "map": [
    "data:rw",
    "homeassistant_config:ro"
  ]
}
